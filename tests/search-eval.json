{
  "$comment": "Search relevance set: each query lists acceptable answers, best first. Run `npm run eval` for hit@1/hit@3/MRR. Phrased the way people actually ask, rarely using the identifier itself.",
  "queries": [
    { "query": "spawn a group of units", "expect": ["BIS_fnc_spawnGroup"] },
    { "query": "shuffle an array", "expect": ["BIS_fnc_arrayShuffle"] },
    { "query": "spawn a vehicle", "expect": ["createVehicle", "BIS_fnc_spawnVehicle"] },
    { "query": "create a vehicle", "expect": ["createVehicle", "BIS_fnc_spawnVehicle"] },
    { "query": "damage a unit", "expect": ["setDamage"] },
    { "query": "execute code on another machine", "expect": ["remoteExec", "remoteExecCall", "BIS_fnc_MP"] },
    { "query": "add a scroll menu action to an object", "expect": ["addAction", "BIS_fnc_holdActionAdd"] },
    { "query": "remove all weapons from a unit", "expect": ["removeAllWeapons"] },
    { "query": "create a map marker", "expect": ["createMarker", "createMarkerLocal"] },
    { "query": "change marker colour", "expect": ["setMarkerColor", "setMarkerColorLocal"] },
    { "query": "show a message on screen", "expect": ["hint", "titleText", "BIS_fnc_showNotification", "cutText", "hintSilent"] },
    { "query": "write to the rpt log file", "expect": ["diag_log"] },
    { "query": "run code when a unit is killed", "expect": ["Killed", "MPKilled", "EntityKilled", "UnitKilled", "addEventHandler", "addMPEventHandler", "addMissionEventHandler"] },
    { "query": "find objects near a position", "expect": ["nearestObjects", "nearObjects", "nearEntities", "nearestObject"] },
    { "query": "delete a vehicle", "expect": ["deleteVehicle"] },
    { "query": "create a task for players", "expect": ["BIS_fnc_taskCreate", "createSimpleTask"] },
    { "query": "wait until a condition is true", "expect": ["waitUntil"] },
    { "query": "pause script execution", "expect": ["sleep", "uiSleep"] },
    { "query": "run a script file", "expect": ["execVM"] },
    { "query": "change the weather fog", "expect": ["setFog"] },
    { "query": "skip time forward", "expect": ["skipTime"] },
    { "query": "put a unit in the driver seat", "expect": ["moveInDriver"] },
    { "query": "order a unit to move somewhere", "expect": ["doMove", "move", "commandMove"] },
    { "query": "make units stealthy or careless", "expect": ["setBehaviour", "setBehaviourStrong"] },
    { "query": "broadcast a variable to all clients", "expect": ["publicVariable", "setVariable"] },
    { "query": "check if running on the server", "expect": ["isServer"] },
    { "query": "store a variable on an object", "expect": ["setVariable"] },
    { "query": "save and restore a unit's gear", "expect": ["getUnitLoadout", "setUnitLoadout"] },
    { "query": "find a safe position to spawn", "expect": ["BIS_fnc_findSafePos"] },
    { "query": "pick a random element from an array", "expect": ["selectRandom", "BIS_fnc_selectRandom"] },
    { "query": "attach an object to a vehicle", "expect": ["attachTo"] },
    { "query": "refuel a vehicle", "expect": ["setFuel"] },
    { "query": "add a waypoint to a group", "expect": ["addWaypoint"] },
    { "query": "make the group patrol an area", "expect": ["BIS_fnc_taskPatrol"] },
    { "query": "end the mission", "expect": ["BIS_fnc_endMission", "endMission"] },
    { "query": "sort an array", "expect": ["sort", "BIS_fnc_sortBy"] },
    { "query": "find the index of an element matching a condition", "expect": ["findIf", "find"] },
    { "query": "split a string into parts", "expect": ["splitString"] },
    { "query": "convert string to number", "expect": ["parseNumber"] },
    { "query": "play an animation on a unit", "expect": ["switchMove", "playMove", "playMoveNow", "BIS_fnc_ambientAnim"] },
    { "query": "all players in the mission", "expect": ["allPlayers"] },
    { "query": "direction from one object to another", "expect": ["getDir", "BIS_fnc_dirTo", "getRelDir"] },
    { "query": "setPosATL", "expect": ["setPosATL"] },
    { "query": "remoteExec", "expect": ["remoteExec"] },
    { "query": "BIS_fnc_holdActionAdd", "expect": ["BIS_fnc_holdActionAdd"] },
    { "query": "getPos", "expect": ["getPos"] },
    { "query": "count", "expect": ["count"] },
    { "query": "select", "expect": ["select"] },
    { "query": "addaction", "expect": ["addAction"] },
    { "query": "setpos", "expect": ["setPos"] }
  ]
}
